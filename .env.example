# Hisabati Scanner — build-time configuration
#
# These are PUBLIC values (they are baked into the client bundle / APK).
# NEVER put a Supabase service role key or any other secret here.
#
# Both variables are required by `npm run build:mobile`. If neither the
# environment variable nor the built-in default in src/lib/hisabati/config.ts
# has a value, the build FAILS instead of shipping an app that cannot log in.

# Hisabati Supabase project URL
VITE_HISABATI_SUPABASE_URL=https://phspovgryirskfyydtzs.supabase.co

# Supabase publishable / anon key (public by design)
VITE_HISABATI_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
